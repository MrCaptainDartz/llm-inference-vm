---
all:
  children:
    servers:
      hosts:
        vm-llm-inference:
          # IP assigned by OpenTofu (iac/outputs.tf → vm_ips)
          ansible_host: 10.0.0.10
      # Ubuntu 26.04 amd64 with internet; builds the airgap bundle (same cloud image as the VM).
    bundle_builder:
      hosts:
        bundle-builder:
          ansible_host: 10.0.0.20
          ansible_user: ubuntu
  vars:
    # Cloud-Init user created by OpenTofu (iac/variables.tf → vm_user)
    ansible_user: ubuntu
    ansible_python_interpreter: /usr/bin/python3
    # ansible_ssh_private_key_file: ~/.ssh/id_ed25519
