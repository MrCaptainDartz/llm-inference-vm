---
all:
  children:
    inference_lxc:
      hosts:
        llm-lxc:
          # IP assigned by OpenTofu (iac/outputs.tf -> lxc_ip).
          ansible_host: 192.0.2.10
          ansible_user: root
    bundle_builder:
      hosts:
        bundle-builder:
          # Online Ubuntu 26.04 host that builds the airgap bundle.
          ansible_host: 192.0.2.20
          ansible_user: ubuntu
  vars:
    ansible_python_interpreter: /usr/bin/python3
