model_list:
  - model_name: "{{ vllm_served_model_name }}"
    litellm_params:
      model: "openai/{{ vllm_served_model_name }}"
      api_base: "http://vllm:8000/v1"
      api_key: "dummy"
{% if vllm_embedding_enabled | bool %}
  - model_name: "{{ vllm_embedding_served_model_name }}"
    litellm_params:
      model: "openai/{{ vllm_embedding_served_model_name }}"
      api_base: "http://vllm-embedding:{{ vllm_embedding_port }}/v1"
      api_key: "dummy"
{% endif %}

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY

litellm_settings:
  drop_params: true
