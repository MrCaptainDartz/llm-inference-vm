[Unit]
Description=SGLang embedding server (RAG /v1/embeddings)
After=llm-network.service

[Container]
ContainerName=sglang-embedding
Image={{ sglang_image }}
Network=llm.network
{% if sglang_gpu | default(false) %}
# NVIDIA GPU access through the CDI specification generated by the nvidia role.
AddDevice=nvidia.com/gpu=all
{% endif %}
# Model weights cache, shared with the main SGLang container.
Volume=%h/models/hf:/root/.cache/huggingface
{% if sglang_offline | default(false) %}
# Airgap: models shipped in the bundle, mounted read-only as plain directories.
Volume=%h/models:/models:ro
Environment=HF_HUB_OFFLINE=1
{% endif %}
# Debug access from the VM itself only; Open WebUI talks over the Podman network.
PublishPort=127.0.0.1:{{ sglang_embedding_port }}:{{ sglang_embedding_port }}
Exec=python3 -m sglang.launch_server --host 0.0.0.0 --port {{ sglang_embedding_port }} \
  --model-path {{ sglang_embedding_model_path }} \
  --is-embedding \
  --served-model-name {{ sglang_embedding_served_model_name }}{% for arg in sglang_embedding_extra_args | default([]) %} \
  {{ arg }}{% endfor %}

[Service]
# First start downloads the model weights: no start timeout.
TimeoutStartSec={{ sglang_timeout_start_sec }}
Restart=always

[Install]
WantedBy=default.target
