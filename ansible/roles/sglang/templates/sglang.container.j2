[Unit]
Description=SGLang inference server
# Ensures the shared network is up before the container starts.
After=llm-network.service

[Container]
ContainerName=sglang
Image={{ sglang_image }}
Network=llm.network
{% if sglang_gpu | default(false) %}
# NVIDIA GPU access through the CDI specification generated by the nvidia role.
AddDevice=nvidia.com/gpu=all
{% endif %}
# Model weights cache, pre-created by Ansible so downloads never run as root.
Volume=%h/models/hf:/root/.cache/huggingface
{% if sglang_offline | default(false) %}
# Airgap: models shipped in the bundle, mounted read-only as plain directories.
Volume=%h/models:/models:ro
Environment=HF_HUB_OFFLINE=1
{% endif %}
# Direct LAN exposure for local coding tools (Claude Code, Pi, omp).
PublishPort={{ sglang_port }}:{{ sglang_port }}
Exec=python3 -m sglang.launch_server --host 0.0.0.0 --port {{ sglang_port }} \
  --model-path {{ sglang_model_path }} \
  --served-model-name {{ sglang_served_model_name }}{% if sglang_api_key | default('') | length > 0 %} \
  --api-key {{ sglang_api_key }}{% endif %}{% if sglang_draft_model_path | default('') | length > 0 %} \
  --speculative-algorithm {{ sglang_speculative_algorithm }} \
  --speculative-draft-model-path {{ sglang_draft_model_path }} \
  --speculative-draft-model-quantization {{ sglang_draft_model_quantization }} \
  --speculative-num-draft-tokens {{ sglang_speculative_num_draft_tokens | default(8) }}{% endif %}{% for arg in sglang_extra_args | default([]) %} \
  {{ arg }}{% endfor %}

[Service]
# First start downloads the model weights: no start timeout.
TimeoutStartSec={{ sglang_timeout_start_sec }}
Restart=always

[Install]
WantedBy=default.target
