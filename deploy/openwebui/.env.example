# Copy to .env and fill in the values from the inference LXC
# (ansible/group_vars/all.yml: litellm_master_key, docling_api_key,
#  litellm_base_url, docling_url).

# LiteLLM (inference LXC)
LITELLM_BASE_URL=http://192.0.2.10:4000/v1
LITELLM_API_KEY=CHANGE-ME-litellm-master-key

# Docling (inference LXC)
DOCLING_SERVER_URL=http://192.0.2.10:5001
DOCLING_API_KEY=CHANGE-ME-docling-api-key

# OCR + tables. Tesseract = fastest, 0 VRAM. EasyOCR = better on
# rotated/noisy scans, slower on CPU and ~1-2 GB VRAM if Docling runs on GPU.
# table_mode=accurate is the TableFormer model (CPU or GPU, not GPU-only);
# do_table_structure=true is explicit even though both are Docling defaults.
DOCLING_PARAMS={"ocr_preset":"tesseract","ocr_lang":["fr"],"table_mode":"accurate","do_table_structure":true}
# DOCLING_PARAMS={"ocr_preset":"easyocr","ocr_lang":["fr"],"table_mode":"accurate","do_table_structure":true}

# Keep this false: the compose/.env wins over settings saved via the Admin UI.
# UI changes still apply until the next restart, then the .env value returns.
ENABLE_PERSISTENT_CONFIG=false

# First boot: true, create the admin account, then set false and restart.
# With ENABLE_PERSISTENT_CONFIG=false this flag cannot be changed persistently
# from the Admin UI; it must be set here. The compose default is false.
ENABLE_SIGNUP=true

# Only trust X-Forwarded-* from a reverse proxy. Set this to the proxy IP or
# Docker network (e.g. 172.18.0.0/16), not '*'.
FORWARDED_ALLOW_IPS=127.0.0.1

# New users are pending until an admin activates them.
DEFAULT_USER_ROLE=pending

# PostgreSQL/pgvector
POSTGRES_PASSWORD=CHANGE-ME-openssl-rand-hex-24

# Open WebUI session signing key
WEBUI_SECRET_KEY=CHANGE-ME-openssl-rand-hex-32

# Set true on the airgap site (no outbound calls from Open WebUI)
OFFLINE_MODE=false
