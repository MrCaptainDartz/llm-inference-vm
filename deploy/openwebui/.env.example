# Copy to .env and fill in values from ansible/group_vars/all.yml.

LITELLM_BASE_URL=http://192.0.2.10:4000/v1
LITELLM_API_KEY=CHANGE-ME-litellm-master-key

DOCLING_SERVER_URL=http://192.0.2.10:5001
DOCLING_API_KEY=CHANGE-ME-docling-api-key

# Tesseract is fastest; easyocr handles noisy scans better.
DOCLING_PARAMS={"ocr_preset":"tesseract","ocr_lang":["fr"],"table_mode":"accurate","do_table_structure":true}

# Keep false: .env wins over Admin UI settings after a restart.
ENABLE_PERSISTENT_CONFIG=false

# First boot: true, create the admin, then false and restart.
ENABLE_SIGNUP=true

# Trust X-Forwarded-* only from a reverse proxy.
FORWARDED_ALLOW_IPS=127.0.0.1

# New users stay pending until an admin activates them.
DEFAULT_USER_ROLE=pending

POSTGRES_PASSWORD=CHANGE-ME-openssl-rand-hex-24
WEBUI_SECRET_KEY=CHANGE-ME-openssl-rand-hex-32

# true on the airgapped site.
OFFLINE_MODE=false
