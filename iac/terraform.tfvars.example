# Copy to terraform.tfvars and fill in the values.

proxmox_api_url   = "https://192.0.2.1:8006/api2/json"
proxmox_api_token = "root@pam!opentofu=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Keep false with a valid certificate; true only for self-signed test endpoints.
proxmox_insecure = false

ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... user@workstation"

vm_node_name          = "pve-node1"
disk_datastore_id     = "local-zfs"   # LXC rootfs
template_datastore_id = "local"       # vztmpl

lxc_id             = 120
lxc_name           = "llm-lxc"
lxc_cores          = 8
lxc_memory_mb      = 32768          # vLLM loads weights through CPU RAM
lxc_disk_size_gb   = 150            # rootfs: images, models/HF cache, Docling models
lxc_unprivileged   = true           # GPU via the Proxmox NVIDIA hook
lxc_ipv4           = "192.0.2.10/24"

network_bridge   = "vmbr0"
network_gateway  = "192.0.2.1"
# network_vlan_id = 100
network_firewall = true
dns_servers      = ["192.0.2.1"]

# start_on_boot = true

# Optional template checksum (recommended).

# Airgap: copy host/ubuntu-26.04-standard_...tar.zst to /var/lib/vz/template/cache/.
# ubuntu_lxc_template_preuploaded = true
