# Copy this file to 'terraform.tfvars' and fill in your values.

# --- Proxmox API (mandatory) ---
proxmox_api_url   = "https://192.0.2.1:8006/api2/json"
proxmox_api_token = "root@pam!opentofu=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Keep false when Proxmox has a valid certificate; set true only for a
# self-signed test endpoint.
proxmox_insecure = false

# SSH user to access Proxmox nodes (default: root)
# proxmox_ssh_username = "root"

# --- SSH Access (mandatory) ---
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... user@workstation"

# --- Proxmox node / storage ---
vm_node_name          = "pve-node1"
disk_datastore_id     = "local-zfs"   # LXC rootfs
template_datastore_id = "local"       # vztmpl

# --- Inference LXC (vLLM + LiteLLM + Docling) ---
lxc_id             = 120
lxc_name           = "llm-lxc"
lxc_cores          = 8
lxc_memory_mb      = 32768          # vLLM loads the 27B weights through CPU RAM
lxc_disk_size_gb   = 150            # rootfs: images + models/HF cache + Docling models
lxc_unprivileged   = true           # GPU via the Proxmox NVIDIA hook
lxc_ipv4           = "192.0.2.10/24"

# --- Network ---
network_bridge   = "vmbr0"
network_gateway  = "192.0.2.1"
# network_vlan_id = 100
network_firewall = true
dns_servers      = ["192.0.2.1"]

# --- Images / templates ---
# ubuntu_lxc_template_url      = "http://download.proxmox.com/images/system/ubuntu-26.04-standard_26.04-1_amd64.tar.zst"
# ubuntu_lxc_template_filename = "ubuntu-26.04-standard_26.04-1_amd64.tar.zst"
# start_on_boot                = true

# Optional but recommended: checksum of the template on the Proxmox host.
# ubuntu_lxc_template_checksum = "<sha256>"
# ubuntu_lxc_template_checksum_algorithm = "sha256"

# --- Airgapped deployment ---
# Copy host/ubuntu-26.04-standard_...tar.zst to /var/lib/vz/template/cache/ then:
# ubuntu_lxc_template_preuploaded = true
